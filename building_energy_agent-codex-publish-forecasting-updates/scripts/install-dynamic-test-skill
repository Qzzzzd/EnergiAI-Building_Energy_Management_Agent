#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
source_root="${project_root}/test-data/dynamic-skill/building-energy-dynamic-proof"
target_root="${project_root}/.agents/skills/building-energy-dynamic-proof"

if [[ -e "${target_root}" ]]; then
  if diff -qr -- "${source_root}" "${target_root}" >/dev/null; then
    printf '%s\n' "Dynamic test Skill is already installed."
    exit 0
  fi
  printf '%s\n' "Refusing to overwrite a different installed dynamic Skill." >&2
  exit 2
fi

cp -a -- "${source_root}" "${target_root}"
printf '%s\n' "Installed building-energy-dynamic-proof. No dependency was installed."
