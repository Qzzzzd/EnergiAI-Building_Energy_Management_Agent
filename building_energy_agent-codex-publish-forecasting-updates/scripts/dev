#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd -- "${project_root}"

check_port() {
  local port="$1"
  if ./scripts/pnpm exec node -e '
    const net = require("node:net");
    const port = Number(process.argv[1]);
    const server = net.createServer();
    server.once("error", () => process.exit(1));
    server.listen(port, "127.0.0.1", () => server.close(() => process.exit(0)));
  ' "${port}"; then
    return 0
  fi
  printf '%s\n' "Port ${port} is already in use." >&2
  return 1
}

check_port "${BE_PORT:-8787}"
check_port "${BE_WEB_PORT:-5173}"

server_pid=""
web_pid=""
cleanup() {
  trap - EXIT INT TERM
  [[ -n "${web_pid}" ]] && kill "${web_pid}" 2>/dev/null || true
  [[ -n "${server_pid}" ]] && kill "${server_pid}" 2>/dev/null || true
  [[ -n "${web_pid}" ]] && wait "${web_pid}" 2>/dev/null || true
  [[ -n "${server_pid}" ]] && wait "${server_pid}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

./scripts/pnpm --filter @building-energy/server run dev &
server_pid="$!"
./scripts/pnpm --filter @building-energy/web run dev --host 127.0.0.1 --port "${BE_WEB_PORT:-5173}" &
web_pid="$!"

printf '%s\n' "Web: http://127.0.0.1:${BE_WEB_PORT:-5173}"
printf '%s\n' "API: http://127.0.0.1:${BE_PORT:-8787}/api/v1/health"

set +e
wait -n "${server_pid}" "${web_pid}"
status="$?"
set -e
exit "${status}"
