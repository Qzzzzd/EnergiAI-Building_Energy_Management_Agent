#!/usr/bin/env python3
"""Read-only discovery and environment checks for repository Skills."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path


def parse_name(skill_file: Path) -> str | None:
    text = skill_file.read_text(encoding="utf-8")
    match = re.search(r"(?m)^name:\s*([^\s]+)\s*$", text)
    return match.group(1) if match else None


def main() -> int:
    parser = argparse.ArgumentParser(prog="skill-doctor")
    parser.add_argument("skills", nargs="*")
    args = parser.parse_args()
    project = Path(__file__).resolve().parents[1]
    skills_root = project / ".agents" / "skills"
    requested = set(args.skills)
    reports = []
    for skill_file in sorted(skills_root.glob("*/SKILL.md")):
        skill_dir = skill_file.parent
        if requested and skill_dir.name not in requested:
            continue
        issues = []
        if parse_name(skill_file) != skill_dir.name:
            issues.append("SKILL_NAME_MISMATCH")
        skillctl = skill_dir / "scripts" / "skillctl"
        lock_file = skill_dir / "requirements.lock"
        # Instruction-only protocol Skills intentionally have no compute
        # entrypoint or environment lock, so they do not use the product's
        # compute metadata contract.
        instruction_only = not skillctl.is_file() and not lock_file.is_file()
        if not instruction_only and not (skill_dir / "agents" / "openai.yaml").is_file():
            issues.append("METADATA_MISSING")
        if skillctl.is_file() != lock_file.is_file():
            issues.append("INSTALL_CONTRACT_INCOMPLETE")
        python = project / ".runtime" / "skill-envs" / skill_dir.name / "bin" / "python"
        if skillctl.is_file() and not python.is_file():
            issues.append("DEPENDENCY_MISSING")
        elif skillctl.is_file():
            check = subprocess.run(
                [str(python), str(skillctl), "--help"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                text=True,
                timeout=10,
                check=False,
            )
            if check.returncode != 0:
                issues.append("ENTRYPOINT_UNAVAILABLE")
            adapter = skill_dir / "scripts" / "skill_adapter.py"
            if adapter.is_file():
                dependency_check = subprocess.run(
                    [
                        str(python),
                        "-B",
                        "-c",
                        (
                            "import importlib.util; "
                            f"s=importlib.util.spec_from_file_location('skill_adapter_probe', {str(adapter)!r}); "
                            "m=importlib.util.module_from_spec(s); s.loader.exec_module(m)"
                        ),
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.PIPE,
                    text=True,
                    timeout=30,
                    check=False,
                )
                if dependency_check.returncode != 0:
                    issues.append("DEPENDENCY_MISSING")
        reports.append(
            {
                "skill_name": skill_dir.name,
                "status": "ready" if not issues else "not_ready",
                "issues": issues,
                "recovery": None if not issues else f"scripts/install-skills {skill_dir.name}",
            }
        )
    missing = requested - {report["skill_name"] for report in reports}
    reports.extend(
        {"skill_name": name, "status": "not_found", "issues": ["SKILL_NOT_FOUND"], "recovery": None}
        for name in sorted(missing)
    )
    print(json.dumps({"status": "ready" if reports and all(report["status"] == "ready" for report in reports) else "not_ready", "skills": reports}, ensure_ascii=False, indent=2))
    return 0 if reports and all(report["status"] == "ready" for report in reports) else 2


if __name__ == "__main__":
    raise SystemExit(main())
