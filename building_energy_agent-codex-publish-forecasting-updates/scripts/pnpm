#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "$(uname -m)" in
  aarch64 | arm64) node_platform="linux-arm64" ;;
  x86_64 | amd64) node_platform="linux-x64" ;;
  *)
    echo "Unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac
node_root="${project_root}/.runtime/toolchains/node-v24.19.0-${node_platform}"
corepack_home="${project_root}/.runtime/toolchains/corepack"

if [[ ! -x "${node_root}/bin/node" ]]; then
  echo "Node toolchain is missing. Run ./scripts/bootstrap-toolchain first." >&2
  exit 1
fi
if [[ ! -f "${corepack_home}/lastKnownGood.json" ]]; then
  echo "Pinned pnpm is missing. Run ./scripts/bootstrap-toolchain during operator preparation." >&2
  exit 1
fi

COREPACK_HOME="${corepack_home}" \
COREPACK_ENABLE_NETWORK=0 \
  COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
  PATH="${node_root}/bin:${node_root}/lib/node_modules/corepack/shims:${PATH}" \
  exec "${node_root}/bin/corepack" pnpm "$@"
