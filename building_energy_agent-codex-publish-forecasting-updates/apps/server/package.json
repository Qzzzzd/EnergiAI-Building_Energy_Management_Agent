{
  "name": "@building-energy/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "bin": {
    "building-energy-public-fetch": "./dist/public-fetch.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "doctor": "tsx src/doctor-cli.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "smoke:codex": "tsx scripts/smoke-real-codex.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@building-energy/contracts": "workspace:*",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.3",
    "@openai/codex": "0.147.0",
    "@openai/codex-sdk": "0.147.0",
    "fastify": "5.11.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
